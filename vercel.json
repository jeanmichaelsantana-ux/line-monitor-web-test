{
  "version": 2,
  "builds": [
    {
      "src": "supabase-proxy.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "relatorio_diario_padrao.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/supabase(?:/(.*))?",
      "dest": "/supabase-proxy.js"
    },
    {
      "src": "/relatorio_diario_padrao\\.html",
      "dest": "/relatorio_diario_padrao.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ]
}
